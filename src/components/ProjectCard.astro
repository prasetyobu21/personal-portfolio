---
import type projects from '../data/projects.json';
interface Props { project: (typeof projects)[number] }
const { project } = Astro.props;
const external = project.href.startsWith('https://');
---
<a href={project.href} target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class="portfolio-card group block overflow-hidden"
  data-category={project.categories} data-date={project.date}
  data-title={project.title} data-subtitle={project.description}
  data-images={project.images ? JSON.stringify(project.images) : undefined}>
  <div class="overflow-hidden bg-surface border border-card-border relative">
    <div class="aspect-[4/3] overflow-hidden relative">
      <div class="img-skeleton"></div>
      <img src={project.image} alt={project.alt} class="card-image w-full h-full object-cover" loading="lazy" />
    </div>
    <div class="card-overlay">
      <span class="card-overlay-text">
        Click to open
        {external && <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3" />
        </svg>}
      </span>
    </div>
  </div>
  <div class="pt-4 pb-2">
    <p class="text-[11px] font-bold text-muted uppercase tracking-wider mb-1">{project.dateLabel}</p>
    <h3 class="card-title text-base md:text-lg font-semibold transition-colors duration-200">{project.title}</h3>
    <p class="text-sm text-muted mt-1">{project.description}</p>
  </div>
</a>
