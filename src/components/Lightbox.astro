<div id="lightbox" class="lightbox-overlay" aria-hidden="true" role="dialog">
  <!-- Close -->
  <button id="lightbox-close" class="lightbox-close" aria-label="Close lightbox">
    <svg class="w-5 h-5" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>

  <!-- Nav arrows -->
  <button id="lightbox-prev" class="lightbox-nav prev" aria-label="Previous image">
    <svg class="w-5 h-5" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
    </svg>
  </button>
  <button id="lightbox-next" class="lightbox-nav next" aria-label="Next image">
    <svg class="w-5 h-5" fill="none" stroke="#fff" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </button>

  <!-- Image area -->
  <div id="lightbox-image-area" class="lightbox-image-area">
    <div id="lightbox-track" class="lightbox-track"></div>
  </div>

  <!-- Bottom: dots + counter -->
  <div class="lightbox-bottom">
    <div id="lightbox-dots" class="lightbox-dots"></div>
    <p id="lightbox-counter" class="lightbox-counter"></p>
  </div>
</div>
